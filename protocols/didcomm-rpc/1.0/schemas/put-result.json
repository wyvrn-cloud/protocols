{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "didcomm-rpc/1.0/put-result",
  "description": "Where the file was written, and what.",
  "type": "object",
  "required": [
    "id",
    "type",
    "from",
    "created_time",
    "body",
    "thid"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender; carried out at most once."
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "The device's DID."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      }
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "thid": {
      "type": "string",
      "minLength": 1,
      "description": "The request's id."
    },
    "type": {
      "const": "https://wyvrn.app/didcomm-rpc/1.0/put-result"
    },
    "body": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "string",
          "minLength": 1,
          "description": "Base58btc multihash of the bytes (sha2-256)."
        }
      },
      "required": [
        "path",
        "byte_count",
        "hash"
      ]
    }
  }
}
