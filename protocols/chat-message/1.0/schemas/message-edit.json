{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chat-message/1.0/message-edit",
  "description": "Replaces the text, mentions or link previews of the sender's own earlier message.",
  "type": "object",
  "required": [
    "id",
    "type",
    "from",
    "created_time",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender; the same id goes to every member of a group."
    },
    "type": {
      "const": "https://wyvrn.app/chat-message/1.0/message-edit"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. Always present: these messages are sent authenticated, and the envelope, not the body, says who sent them."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      }
    },
    "pthid": {
      "type": "string",
      "description": "In a group conversation, the group's id. Absent in a pair."
    },
    "thid": {
      "type": "string",
      "description": "In a thread (chat-threads/1.0), the thread's id. Otherwise absent."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds; set under a disappearing-messages/1.0 timer."
    },
    "lang": {
      "type": "string",
      "description": "IANA language tag of content."
    },
    "body": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "object",
          "required": [
            "id",
            "author"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The id of the message referred to. Compared case-insensitively."
            },
            "author": {
              "type": "string",
              "pattern": "^did:[a-z0-9]+:[^#]+$",
              "description": "The DID that sent it, as the referring party knows it (its current DID or one it rotated away from)."
            }
          },
          "description": "The message edited."
        },
        "content": {
          "type": "string",
          "maxLength": 8000
        },
        "mentions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "did"
                ],
                "properties": {
                  "did": {
                    "type": "string",
                    "pattern": "^did:[a-z0-9]+:[^#]+$"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "everyone"
                ],
                "properties": {
                  "everyone": {
                    "const": true
                  }
                }
              }
            ]
          },
          "description": "Members mentioned, each also written in content as a Markdown link to its DID; or everyone. Groups only."
        },
        "embeds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "The link, exactly as it appears in content."
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "site_name": {
                "type": "string"
              },
              "image": {
                "type": "string",
                "description": "The attachment id of an inline thumbnail."
              }
            }
          },
          "description": "Link previews built by the sender for links in content."
        }
      },
      "anyOf": [
        {
          "required": [
            "content"
          ]
        },
        {
          "required": [
            "mentions"
          ]
        },
        {
          "required": [
            "embeds"
          ]
        }
      ]
    }
  }
}
