{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "files/1.0/extend",
  "description": "Asks for a stored file to be kept longer.",
  "type": "object",
  "required": [
    "id",
    "type",
    "from",
    "created_time",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "The uploader's DID: always present, the message is sender-authenticated."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      }
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "return_route": {
      "type": "string",
      "description": "Usually \"all\": answered in the same HTTP response."
    },
    "type": {
      "const": "https://wyvrn.app/files/1.0/extend"
    },
    "body": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "The host's id for the file."
        },
        "keep_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "How long from now."
        }
      },
      "required": [
        "file",
        "keep_seconds"
      ]
    }
  }
}
