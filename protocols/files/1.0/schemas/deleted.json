{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "files/1.0/deleted",
  "description": "The file is gone.",
  "type": "object",
  "required": [
    "id",
    "type",
    "from",
    "created_time",
    "body",
    "thid"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "The host's DID."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      }
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "thid": {
      "type": "string",
      "minLength": 1,
      "description": "The id of the message this answers."
    },
    "type": {
      "const": "https://wyvrn.app/files/1.0/deleted"
    },
    "body": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "The host's id for the file."
        }
      },
      "required": [
        "file"
      ]
    }
  }
}
