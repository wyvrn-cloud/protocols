{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "documentation/1.1/spec-response",
  "description": "A document's table of contents (toc, with the list of documents the registry serves) or one section (including its subsections).",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://wyvrn.app/documentation/1.1/spec-response"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "required": [
        "document",
        "version",
        "title"
      ],
      "properties": {
        "document": {
          "type": "string",
          "description": "The document returned."
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "didcomm_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9^~=<>*., ]+$",
            "examples": [
              "^1.0",
              "^2.0",
              "~2.1",
              ">=2.0, <3.0"
            ]
          },
          "description": "DIDComm Messaging versions this document applies to."
        },
        "source": {
          "type": "object",
          "description": "Where the documentation came from.",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "toc": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "level": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "section": {
          "type": "object",
          "required": [
            "id",
            "title",
            "markdown"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            }
          }
        },
        "documents": {
          "type": "array",
          "description": "Every document the registry serves. Sent with a toc.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "versions"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Values accepted as version for this document, newest published first."
              },
              "didcomm_versions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9^~=<>*., ]+$",
                  "examples": [
                    "^1.0",
                    "^2.0",
                    "~2.1",
                    ">=2.0, <3.0"
                  ]
                },
                "description": "DIDComm Messaging versions this applies to, as semantic-version requirements (Cargo/npm syntax: ^2.0 = any 2.x). Satisfied if any item is."
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "toc"
          ]
        },
        {
          "required": [
            "section"
          ]
        }
      ]
    }
  }
}
