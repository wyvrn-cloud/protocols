{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "documentation/1.1/catalog",
  "description": "One page of catalog entries matching a query.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://wyvrn.app/documentation/1.1/catalog"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "required": [
        "entries",
        "total",
        "offset"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "piuri",
              "title",
              "status"
            ],
            "properties": {
              "piuri": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "has_schemas": {
                "type": "boolean",
                "description": "Whether the registry has JSON Schemas for this protocol's messages."
              },
              "didcomm_versions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9^~=<>*., ]+$",
                  "examples": [
                    "^1.0",
                    "^2.0",
                    "~2.1",
                    ">=2.0, <3.0"
                  ]
                },
                "description": "DIDComm Messaging versions this applies to, as semantic-version requirements (Cargo/npm syntax: ^2.0 = any 2.x). Satisfied if any item is."
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Other PIURIs this protocol is known by (legacy did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/ prefixes, underscore spellings). A registry accepts them in a request."
              }
            }
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
