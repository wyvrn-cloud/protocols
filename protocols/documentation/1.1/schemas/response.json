{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "documentation/1.1/response",
  "description": "One protocol's definition. piuri is the version actually returned, which may be a different minor version than requested.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://wyvrn.app/documentation/1.1/response"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "required": [
        "piuri",
        "title",
        "status",
        "available_sections"
      ],
      "properties": {
        "piuri": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "didcomm_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9^~=<>*., ]+$",
            "examples": [
              "^1.0",
              "^2.0",
              "~2.1",
              ">=2.0, <3.0"
            ]
          },
          "description": "DIDComm Messaging versions this applies to, as semantic-version requirements (Cargo/npm syntax: ^2.0 = any 2.x). Satisfied if any item is."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other PIURIs this protocol is known by (legacy did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/ prefixes, underscore spellings). A registry accepts them in a request."
        },
        "summary": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "description": "Where the documentation came from.",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "available_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "markdown"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "markdown": {
                "type": "string"
              }
            }
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Message type URI, as DIDComm v2 type or DIDComm v1 @type."
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "schema": {
                "type": "object",
                "description": "JSON Schema 2020-12 for the complete plaintext message. Kept for documentation/1.0 requesters: when schemas lists several, this is the one for the newest DIDComm version."
              },
              "didcomm_versions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9^~=<>*., ]+$",
                  "examples": [
                    "^1.0",
                    "^2.0",
                    "~2.1",
                    ">=2.0, <3.0"
                  ]
                },
                "description": "DIDComm Messaging versions this message type is used with."
              },
              "schemas": {
                "type": "array",
                "description": "Every known schema for this message type, one per DIDComm envelope style (a v1 message has @type, @id and ~decorators; a v2 message has type, id and body).",
                "items": {
                  "type": "object",
                  "required": [
                    "didcomm_versions",
                    "schema"
                  ],
                  "properties": {
                    "didcomm_versions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9^~=<>*., ]+$",
                        "examples": [
                          "^1.0",
                          "^2.0",
                          "~2.1",
                          ">=2.0, <3.0"
                        ]
                      },
                      "description": "DIDComm Messaging versions this applies to, as semantic-version requirements (Cargo/npm syntax: ^2.0 = any 2.x). Satisfied if any item is."
                    },
                    "schema": {
                      "type": "object",
                      "description": "JSON Schema 2020-12 for the complete plaintext message."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
