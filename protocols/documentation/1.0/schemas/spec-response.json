{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "documentation/1.0/spec-response",
  "description": "The spec's table of contents (toc) or one section (including its subsections).",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://wyvrn.app/documentation/1.0/spec-response"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "required": [
        "version",
        "title"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "description": "Where the documentation came from.",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "toc": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "level": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "section": {
          "type": "object",
          "required": [
            "id",
            "title",
            "markdown"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "toc"
          ]
        },
        {
          "required": [
            "section"
          ]
        }
      ]
    }
  }
}
