{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "did-hosting/1.0/status",
  "description": "Host to anyone: how a name stands.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://wyvrn.app/did-hosting/1.0/status"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. Every message of this protocol is authcrypted, so it is always present."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "return_route": {
      "enum": [
        "none",
        "all",
        "thread"
      ],
      "description": "return_route extension; set to all to receive the reply on the same connection."
    },
    "body": {
      "type": "object",
      "required": [],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){1,30}[a-z0-9](?::[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){1,30}[a-z0-9])*$",
          "description": "A name: labels of 3 to 32 characters (a-z, 0-9, -; no leading, trailing or doubled hyphen) joined by ':'."
        },
        "state": {
          "enum": [
            "free",
            "reserved",
            "held",
            "published",
            "stale",
            "deactivated"
          ]
        },
        "did": {
          "type": "string",
          "pattern": "^did:webvh:.+",
          "description": "The hosted did:webvh, when there is one."
        },
        "version_id": {
          "type": "string",
          "description": "The last hosted entry's versionId, when there is one."
        },
        "whois": {
          "type": "boolean",
          "description": "Whether a whois is published."
        },
        "yours": {
          "type": "boolean",
          "description": "Whether the sender is the holder, or the one it is held for or assigned to."
        }
      }
    }
  }
}
